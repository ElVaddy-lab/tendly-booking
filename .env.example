# Public (safe for the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local values: run `pnpm supabase:start`, then `pnpm exec supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile test key that always passes
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-only secrets — never prefix with NEXT_PUBLIC_, never commit real values
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
TELEGRAM_BOT_TOKEN=
CRON_SECRET=
